pipeline {
    agent any
    
    environment {
        TF_TOKEN_app_terraform_io = credentials('tf-token-terraform-cloud')
    }
    
    stages {
        
        // Drift Audit Matrix
        stage('Drift Audit Matrix') {
            matrix {
                axes {
                    axis {
                        name 'TOOL'
                        values 'terraform', 'opentofu'
                    }
                    axis {
                        name 'CLOUD'
                        values 'aws', 'azure', 'gcp', 'oci'
                    }
                    axis {
                        name 'ENVIRONMENT'
                        values 'dev', 'staging', 'prod'
                    }
                }
                
                stages {
                    
                    // Check Drift
                    stage('Check Drift') {
                        steps {
                            dir("01-iac-railways/${TOOL}/${CLOUD}") {
                                script {
                                    // Variáveis locais são thread-safe (isoladas por job)
                                    def iac_cmd = ''
                                    def tf_workspace = ''
                                    
                                    if (TOOL == 'terraform') {
                                        iac_cmd = 'terraform'
                                        def wsMap = [aws: 'aws_tfc', azure: 'azure_tfc', gcp: 'gcp_tfc', oci: 'oci_tfc']
                                        tf_workspace = "${ENVIRONMENT}_${wsMap[CLOUD]}"
                                    } else {
                                        iac_cmd = 'tofu'
                                        def wsMap = [aws: 'aws_tofu', azure: 'azure_tofu', gcp: 'gcp_tofu', oci: 'oci_tofu']
                                        tf_workspace = "${ENVIRONMENT}_${wsMap[CLOUD]}"
                                    }
                                    
                                    // withEnv injeta as variáveis APENAS neste bloco, evitando conflito entre os 24 jobs paralelos
                                    withEnv(["IAC_CMD=${iac_cmd}", "TF_WORKSPACE=${tf_workspace}", "TF_VAR_ENVIRONMENT=${ENVIRONMENT}"]) {
                                        sh '${IAC_CMD} init'
                                        
                                        def exitCode = sh(script: '${IAC_CMD} plan -detailed-exitcode', returnStatus: true)
                                        if (exitCode == 2) {
                                            echo "🚨 DRIFT DETECTADO em ${TOOL} - ${CLOUD} - ${ENVIRONMENT} 🚨"
                                            currentBuild.result = 'FAILURE'
                                        } else if (exitCode != 0) {
                                            error("Erro ao executar o plan.")
                                        } else {
                                            echo "✅ Sem drift em ${TOOL} - ${CLOUD} - ${ENVIRONMENT}"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}