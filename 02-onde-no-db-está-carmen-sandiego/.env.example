# ==============================================================
# paranauelabs / carmen — variáveis do laboratório
#
# Uso: cp .env.example .env   (e ajuste o que precisar)
#
# Regras da casa:
#   - .env é gitignored (overrides locais); este arquivo é o
#     gêmeo versionado que documenta as variáveis.
#   - Toda variável tem default idêntico embutido no
#     docker-compose.yml e nas APIs: um clone limpo sobe SEM .env
#     (Requisito D / Outcome 3 intactos).
#   - Credenciais fake de laboratório, válidas só no localhost.
# ==============================================================

# ── PostgreSQL (python-api / SQLAlchemy 2.0) ──────────────────
POSTGRES_USER=acme
POSTGRES_PASSWORD=acme
POSTGRES_DB=carmen
# Perspectiva da MÁQUINA (modo dev: APIs no host). No profile
# full (APIs containerizadas), o compose sobrescreve host/port
# pelos nomes internos dos serviços.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ── MongoDB (node-api / Mongoose) ─────────────────────────────
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=carmen

# ── Portas das APIs no modo dev ──────────────────────---------
NODE_API_PORT=7421
PYTHON_API_PORT=7422