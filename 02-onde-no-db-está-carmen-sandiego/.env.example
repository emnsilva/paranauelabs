# ==============================================================
# paranauelabs / carmen — valores do laboratório
#
# OBRIGATORIO: o compose nao tem defaults embutidos -- sem este
# arquivo (como .env), nada sobe. Bootstrap: cp .env.example .env
# (o make up faz isso automaticamente)
# ==============================================================

# binding das portas publicadas. 127.0.0.1 = so localhost (postura
# do lab). MUDAR PARA 0.0.0.0 expoe em todas as interfaces da VM --
# para acesso externo, o caminho sancionado e tunel SSH.
BIND_HOST=127.0.0.1

# ── PostgreSQL (python-api) ────────────────────────────────────
POSTGRES_USER=acme
POSTGRES_PASSWORD=acme
POSTGRES_DB=carmen
POSTGRES_PORT=5433            # porta na MAQUINA (evita conflito com postgres local)
PG_INTERNAL_PORT=5432         # porta DENTRO do container (contrato da imagem
                              # postgres oficial -- nao troque sem motivo)
PG_VOLUME=carmen_pg_data      # trocar o nome = volume novo (dados zeram)

# ── MongoDB (node-api) ─────────────────────────────────────────
MONGO_PORT=27017
MONGO_INTERNAL_PORT=27017     # idem: contrato da imagem mongo oficial
MONGO_DB=carmen
MONGO_VOLUME=carmen_mongo_data

# ── APIs ───────────────────────────────────────────────────────
NODE_API_PORT=7421              # porta na MÁQUINA
NODE_API_INTERNAL_PORT=7421     # porta DENTRO do container (a app escuta nela)
PYTHON_API_PORT=7422
PYTHON_API_INTERNAL_PORT=7422