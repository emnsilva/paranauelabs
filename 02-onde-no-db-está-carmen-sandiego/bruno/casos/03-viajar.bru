meta {
  name: 03-viajar
  seq: 3
}

post {
  url: {{base_url}}/cases/{{case_id}}/travel
  body: json
  auth: none
}

body:json {
  {
    "city": "{{cidade_destino}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const texto = JSON.stringify(res.body);
    const pistas = texto.match(/"revealed_trait"/g) || [];
    bru.setVar('pistas_reveladas', pistas.length);
    // o próximo heading_to alimenta a PRÓXIMA execução deste request
    const h = texto.match(/"heading_to":"([^"]*)"/);
    if (h) {
      bru.setEnvVar('cidade_destino', h[1]);
    }
  }
}

tests {
  test('viagem aceita (200) ou conflito (409) — ambos no contrato', function() {
    expect([200, 409]).to.include(res.status);
  });

  test('200 revela pista (revealed_trait presente)', function() {
    if (res.status === 200) {
      expect(JSON.stringify(res.body)).to.include('revealed_trait');
    }
  });

  test('x-request-id ecoado (Req. F)', function() {
    expect((res.headers['x-request-id'] || '').startsWith('bru-')).to.be.true;
  });
}