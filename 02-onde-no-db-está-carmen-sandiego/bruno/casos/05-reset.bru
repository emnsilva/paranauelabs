meta {
  name: 05-reset
  seq: 5
}

post {
  url: {{base_url}}/api/seed
  body: none
  auth: none
}

tests {
  test('200 no reset', function() {
    expect(res.status).to.equal(200);
  });

  test('estado restaurado: 20 bandidos, 12 cidades, casos apagados', function() {
    expect(res.body.status).to.equal('reset');
    expect(res.body.criminals).to.equal(20);
    expect(res.body.cities).to.equal(12);
    expect(res.body.cases_deleted).to.equal(true);
  });

  test('x-request-id ecoado (Req. F)', function() {
    expect((res.headers['x-request-id'] || '').startsWith('bru-')).to.be.true;
  });
}