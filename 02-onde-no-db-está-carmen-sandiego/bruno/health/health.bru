meta {
  name: health
  seq: 1
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

script:pre-request {
  // demonstra a PROPAGAÇÃO (Req. F): id fixo enviado deve voltar idêntico
  req.setHeader('x-request-id', 'detetive-bruno-001');
}

tests {
  test('200 no health', function() {
    expect(res.status).to.equal(200);
  });

  test('x-request-id propagado e ecoado idêntico (Req. F)', function() {
    expect(res.headers['x-request-id']).to.equal('detetive-bruno-001');
  });
}